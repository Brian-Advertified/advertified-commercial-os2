{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Advertified af-south-1 launch topology. Uses existing VPC/subnets and creates hardened app/data EC2 resources, private storage, immutable ECR, EventBridge, DNS, monitoring and automated EBS snapshots. No production deployment is performed by this template file itself.",
  "Parameters": {
    "VpcId": {
      "Type": "AWS::EC2::VPC::Id"
    },
    "PublicSubnetId": {
      "Type": "AWS::EC2::Subnet::Id"
    },
    "PrivateSubnetId": {
      "Type": "AWS::EC2::Subnet::Id"
    },
    "AppAmiId": {
      "Type": "AWS::EC2::Image::Id",
      "Description": "Ubuntu Server 24.04 LTS x86_64 AMI; UserData fails closed on another OS."
    },
    "DataAmiId": {
      "Type": "AWS::EC2::Image::Id",
      "Description": "Ubuntu Server 24.04 LTS x86_64 AMI; UserData fails closed on another OS."
    },
    "AppInstanceType": {
      "Type": "String",
      "Default": "t3.small"
    },
    "DataInstanceType": {
      "Type": "String",
      "Default": "t3.small"
    },
    "DatabaseVolumeSizeGiB": {
      "Type": "Number",
      "Default": 50,
      "MinValue": 20
    },
    "HostedZoneId": {
      "Type": "AWS::Route53::HostedZone::Id"
    },
    "DomainName": {
      "Type": "String",
      "MinLength": 3
    },
    "NotificationTopicArn": {
      "Type": "String",
      "MinLength": 20
    },
    "ApplicationSecretsArn": {
      "Type": "String",
      "MinLength": 20,
      "NoEcho": true
    },
    "AgentSecretsArn": {
      "Type": "String",
      "MinLength": 20,
      "NoEcho": true
    },
    "DatabaseSecretsArn": {
      "Type": "String",
      "MinLength": 20,
      "NoEcho": true
    },
    "SnapshotRetentionCount": {
      "Type": "Number",
      "MinValue": 1,
      "MaxValue": 100
    },
    "LogicalBackupRetentionDays": {
      "Type": "Number",
      "MinValue": 1,
      "MaxValue": 3650
    }
  },
  "Resources": {
    "ApplicationSecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "Advertified TLS edge only",
        "VpcId": {
          "Ref": "VpcId"
        },
        "SecurityGroupIngress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 80,
            "ToPort": 80,
            "CidrIp": "0.0.0.0/0"
          },
          {
            "IpProtocol": "tcp",
            "FromPort": 443,
            "ToPort": 443,
            "CidrIp": "0.0.0.0/0"
          }
        ],
        "Tags": [
          {
            "Key": "Name",
            "Value": "advertified-production-app"
          }
        ]
      }
    },
    "DatabaseSecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "Advertified private PostgreSQL from application host only",
        "VpcId": {
          "Ref": "VpcId"
        },
        "SecurityGroupIngress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 5432,
            "ToPort": 5432,
            "SourceSecurityGroupId": {
              "Ref": "ApplicationSecurityGroup"
            }
          }
        ],
        "Tags": [
          {
            "Key": "Name",
            "Value": "advertified-production-data"
          }
        ]
      }
    },
    "InventoryBucket": {
      "Type": "AWS::S3::Bucket",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            {
              "ServerSideEncryptionByDefault": {
                "SSEAlgorithm": "AES256"
              }
            }
          ]
        },
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "BlockPublicPolicy": true,
          "IgnorePublicAcls": true,
          "RestrictPublicBuckets": true
        },
        "VersioningConfiguration": {
          "Status": "Enabled"
        }
      }
    },
    "BackupBucket": {
      "Type": "AWS::S3::Bucket",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            {
              "ServerSideEncryptionByDefault": {
                "SSEAlgorithm": "AES256"
              }
            }
          ]
        },
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "BlockPublicPolicy": true,
          "IgnorePublicAcls": true,
          "RestrictPublicBuckets": true
        },
        "VersioningConfiguration": {
          "Status": "Enabled"
        },
        "LifecycleConfiguration": {
          "Rules": [
            {
              "Id": "OwnerApprovedLogicalBackupRetention",
              "Status": "Enabled",
              "ExpirationInDays": {
                "Ref": "LogicalBackupRetentionDays"
              },
              "NoncurrentVersionExpiration": {
                "NoncurrentDays": {
                  "Ref": "LogicalBackupRetentionDays"
                }
              }
            }
          ]
        }
      }
    },
    "ApiRepository": {
      "Type": "AWS::ECR::Repository",
      "Properties": {
        "RepositoryName": "advertified/commercial-api",
        "ImageTagMutability": "IMMUTABLE",
        "ImageScanningConfiguration": {
          "ScanOnPush": true
        },
        "EncryptionConfiguration": {
          "EncryptionType": "AES256"
        }
      }
    },
    "MigratorRepository": {
      "Type": "AWS::ECR::Repository",
      "Properties": {
        "RepositoryName": "advertified/database-migrator",
        "ImageTagMutability": "IMMUTABLE",
        "ImageScanningConfiguration": {
          "ScanOnPush": true
        },
        "EncryptionConfiguration": {
          "EncryptionType": "AES256"
        }
      }
    },
    "AgentRuntimeRepository": {
      "Type": "AWS::ECR::Repository",
      "Properties": {
        "RepositoryName": "advertified/agent-runtime",
        "ImageTagMutability": "IMMUTABLE",
        "ImageScanningConfiguration": {
          "ScanOnPush": true
        },
        "EncryptionConfiguration": {
          "EncryptionType": "AES256"
        }
      }
    },
    "WebRepository": {
      "Type": "AWS::ECR::Repository",
      "Properties": {
        "RepositoryName": "advertified/web",
        "ImageTagMutability": "IMMUTABLE",
        "ImageScanningConfiguration": {
          "ScanOnPush": true
        },
        "EncryptionConfiguration": {
          "EncryptionType": "AES256"
        }
      }
    },
    "DatabaseRepository": {
      "Type": "AWS::ECR::Repository",
      "Properties": {
        "RepositoryName": "advertified/postgres",
        "ImageTagMutability": "IMMUTABLE",
        "ImageScanningConfiguration": {
          "ScanOnPush": true
        },
        "EncryptionConfiguration": {
          "EncryptionType": "AES256"
        }
      }
    },
    "CommercialEventBus": {
      "Type": "AWS::Events::EventBus",
      "Properties": {
        "Name": "advertified-commercial"
      }
    },
    "ApplicationRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "ec2.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "ManagedPolicyArns": [
          "arn:aws:iam::aws:policy/AmazonSSMManagedInstanceCore"
        ],
        "Policies": [
          {
            "PolicyName": "AdvertifiedApplicationRuntime",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:GetObject",
                    "s3:PutObject",
                    "s3:DeleteObject"
                  ],
                  "Resource": {
                    "Fn::Sub": "${InventoryBucket.Arn}/*"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:ListBucket"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "InventoryBucket",
                      "Arn"
                    ]
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "events:PutEvents",
                    "events:DescribeEventBus"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "CommercialEventBus",
                      "Arn"
                    ]
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "bedrock:InvokeModel"
                  ],
                  "Resource": "*"
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "secretsmanager:GetSecretValue"
                  ],
                  "Resource": [
                    {
                      "Ref": "ApplicationSecretsArn"
                    },
                    {
                      "Ref": "AgentSecretsArn"
                    }
                  ]
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "ecr:GetAuthorizationToken"
                  ],
                  "Resource": "*"
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "ecr:BatchCheckLayerAvailability",
                    "ecr:GetDownloadUrlForLayer",
                    "ecr:BatchGetImage"
                  ],
                  "Resource": [
                    {
                      "Fn::GetAtt": [
                        "ApiRepository",
                        "Arn"
                      ]
                    },
                    {
                      "Fn::GetAtt": [
                        "MigratorRepository",
                        "Arn"
                      ]
                    },
                    {
                      "Fn::GetAtt": [
                        "AgentRuntimeRepository",
                        "Arn"
                      ]
                    },
                    {
                      "Fn::GetAtt": [
                        "WebRepository",
                        "Arn"
                      ]
                    }
                  ]
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "cloudwatch:PutMetricData",
                    "logs:CreateLogStream",
                    "logs:PutLogEvents"
                  ],
                  "Resource": "*"
                }
              ]
            }
          }
        ]
      }
    },
    "ApplicationInstanceProfile": {
      "Type": "AWS::IAM::InstanceProfile",
      "Properties": {
        "Roles": [
          {
            "Ref": "ApplicationRole"
          }
        ]
      }
    },
    "DatabaseRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "ec2.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "ManagedPolicyArns": [
          "arn:aws:iam::aws:policy/AmazonSSMManagedInstanceCore"
        ],
        "Policies": [
          {
            "PolicyName": "AdvertifiedDatabaseBackup",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:ListBucket"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "BackupBucket",
                      "Arn"
                    ]
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:GetObject",
                    "s3:PutObject"
                  ],
                  "Resource": {
                    "Fn::Sub": "${BackupBucket.Arn}/*"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "secretsmanager:GetSecretValue"
                  ],
                  "Resource": {
                    "Ref": "DatabaseSecretsArn"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "ecr:GetAuthorizationToken"
                  ],
                  "Resource": "*"
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "ecr:BatchCheckLayerAvailability",
                    "ecr:GetDownloadUrlForLayer",
                    "ecr:BatchGetImage"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "DatabaseRepository",
                      "Arn"
                    ]
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "cloudwatch:PutMetricData",
                    "logs:CreateLogStream",
                    "logs:PutLogEvents"
                  ],
                  "Resource": "*"
                }
              ]
            }
          }
        ]
      }
    },
    "DatabaseInstanceProfile": {
      "Type": "AWS::IAM::InstanceProfile",
      "Properties": {
        "Roles": [
          {
            "Ref": "DatabaseRole"
          }
        ]
      }
    },
    "ApplicationHost": {
      "Type": "AWS::EC2::Instance",
      "Properties": {
        "ImageId": {
          "Ref": "AppAmiId"
        },
        "InstanceType": {
          "Ref": "AppInstanceType"
        },
        "SubnetId": {
          "Ref": "PublicSubnetId"
        },
        "SecurityGroupIds": [
          {
            "Ref": "ApplicationSecurityGroup"
          }
        ],
        "IamInstanceProfile": {
          "Ref": "ApplicationInstanceProfile"
        },
        "Monitoring": true,
        "BlockDeviceMappings": [
          {
            "DeviceName": "/dev/sda1",
            "Ebs": {
              "Encrypted": true,
              "VolumeType": "gp3",
              "DeleteOnTermination": true
            }
          }
        ],
        "MetadataOptions": {
          "HttpTokens": "required",
          "HttpEndpoint": "enabled"
        },
        "Tags": [
          {
            "Key": "Name",
            "Value": "advertified-production-app"
          },
          {
            "Key": "AdvertifiedEnvironment",
            "Value": "production"
          }
        ],
        "UserData": {
          "Fn::Base64": {
            "Fn::Join": [
              "",
              [
                "#!/usr/bin/env bash\nset -euo pipefail\n",
                "install -d -m 0755 /opt/advertified/bootstrap\n",
                "printf '%s' '",
                "",
                "' | base64 --decode | tar -xz -C /opt/advertified/bootstrap\n",
                "export ADVERTIFIED_AWS_REGION='",
                {
                  "Ref": "AWS::Region"
                },
                "'\n",
                "/opt/advertified/bootstrap/bootstrap-application-host.sh\n"
              ]
            ]
          }
        }
      }
    },
    "ApplicationElasticIp": {
      "Type": "AWS::EC2::EIP",
      "Properties": {
        "Domain": "vpc"
      }
    },
    "ApplicationElasticIpAssociation": {
      "Type": "AWS::EC2::EIPAssociation",
      "Properties": {
        "AllocationId": {
          "Fn::GetAtt": [
            "ApplicationElasticIp",
            "AllocationId"
          ]
        },
        "InstanceId": {
          "Ref": "ApplicationHost"
        }
      }
    },
    "DatabaseHost": {
      "Type": "AWS::EC2::Instance",
      "Properties": {
        "ImageId": {
          "Ref": "DataAmiId"
        },
        "InstanceType": {
          "Ref": "DataInstanceType"
        },
        "SubnetId": {
          "Ref": "PrivateSubnetId"
        },
        "SecurityGroupIds": [
          {
            "Ref": "DatabaseSecurityGroup"
          }
        ],
        "IamInstanceProfile": {
          "Ref": "DatabaseInstanceProfile"
        },
        "Monitoring": true,
        "BlockDeviceMappings": [
          {
            "DeviceName": "/dev/sda1",
            "Ebs": {
              "Encrypted": true,
              "VolumeType": "gp3",
              "DeleteOnTermination": true
            }
          }
        ],
        "MetadataOptions": {
          "HttpTokens": "required",
          "HttpEndpoint": "enabled"
        },
        "Tags": [
          {
            "Key": "Name",
            "Value": "advertified-production-data"
          },
          {
            "Key": "AdvertifiedEnvironment",
            "Value": "production"
          }
        ],
        "UserData": {
          "Fn::Base64": {
            "Fn::Join": [
              "",
              [
                "#!/usr/bin/env bash\nset -euo pipefail\n",
                "install -d -m 0755 /opt/advertified/bootstrap\n",
                "printf '%s' '",
                "",
                "' | base64 --decode | tar -xz -C /opt/advertified/bootstrap\n",
                "export ADVERTIFIED_AWS_REGION='",
                {
                  "Ref": "AWS::Region"
                },
                "'\n",
                "export ADVERTIFIED_BACKUP_BUCKET='",
                {
                  "Ref": "BackupBucket"
                },
                "'\nexport ADVERTIFIED_DATABASE_SECRET_ARN='",
                {
                  "Ref": "DatabaseSecretsArn"
                },
                "'\n",
                "/opt/advertified/bootstrap/bootstrap-database-host.sh\n"
              ]
            ]
          }
        }
      }
    },
    "DatabaseVolume": {
      "Type": "AWS::EC2::Volume",
      "DeletionPolicy": "Snapshot",
      "UpdateReplacePolicy": "Snapshot",
      "Properties": {
        "AvailabilityZone": {
          "Fn::GetAtt": [
            "DatabaseHost",
            "AvailabilityZone"
          ]
        },
        "Encrypted": true,
        "Size": {
          "Ref": "DatabaseVolumeSizeGiB"
        },
        "VolumeType": "gp3",
        "Tags": [
          {
            "Key": "Name",
            "Value": "advertified-production-postgres"
          },
          {
            "Key": "AdvertifiedBackup",
            "Value": "Database"
          }
        ]
      }
    },
    "DatabaseVolumeAttachment": {
      "Type": "AWS::EC2::VolumeAttachment",
      "Properties": {
        "Device": "/dev/sdf",
        "InstanceId": {
          "Ref": "DatabaseHost"
        },
        "VolumeId": {
          "Ref": "DatabaseVolume"
        }
      }
    },
    "SnapshotLifecycleRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "dlm.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "AdvertifiedDatabaseSnapshots",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "ec2:CreateSnapshot",
                    "ec2:DeleteSnapshot",
                    "ec2:DescribeVolumes",
                    "ec2:DescribeSnapshots",
                    "ec2:CreateTags"
                  ],
                  "Resource": "*"
                }
              ]
            }
          }
        ]
      }
    },
    "DatabaseSnapshotPolicy": {
      "Type": "AWS::DLM::LifecyclePolicy",
      "Properties": {
        "Description": "Advertified automated database EBS snapshots",
        "State": "ENABLED",
        "ExecutionRoleArn": {
          "Fn::GetAtt": [
            "SnapshotLifecycleRole",
            "Arn"
          ]
        },
        "PolicyDetails": {
          "ResourceTypes": [
            "VOLUME"
          ],
          "TargetTags": [
            {
              "Key": "AdvertifiedBackup",
              "Value": "Database"
            }
          ],
          "Schedules": [
            {
              "Name": "DailyDatabaseSnapshots",
              "CreateRule": {
                "Interval": 24,
                "IntervalUnit": "HOURS",
                "Times": [
                  "02:00"
                ]
              },
              "RetainRule": {
                "Count": {
                  "Ref": "SnapshotRetentionCount"
                }
              },
              "CopyTags": true
            }
          ]
        }
      }
    },
    "ProductionDns": {
      "Type": "AWS::Route53::RecordSet",
      "Properties": {
        "HostedZoneId": {
          "Ref": "HostedZoneId"
        },
        "Name": {
          "Ref": "DomainName"
        },
        "Type": "A",
        "TTL": "60",
        "ResourceRecords": [
          {
            "Fn::GetAtt": [
              "ApplicationElasticIp",
              "PublicIp"
            ]
          }
        ]
      }
    },
    "ApplicationStatusAlarm": {
      "Type": "AWS::CloudWatch::Alarm",
      "Properties": {
        "AlarmDescription": "Advertified application EC2 status check failed",
        "Namespace": "AWS/EC2",
        "MetricName": "StatusCheckFailed",
        "Dimensions": [
          {
            "Name": "InstanceId",
            "Value": {
              "Ref": "ApplicationHost"
            }
          }
        ],
        "Statistic": "Maximum",
        "Period": 60,
        "EvaluationPeriods": 2,
        "Threshold": 1,
        "ComparisonOperator": "GreaterThanOrEqualToThreshold",
        "TreatMissingData": "breaching",
        "AlarmActions": [
          {
            "Ref": "NotificationTopicArn"
          }
        ]
      }
    },
    "DatabaseStatusAlarm": {
      "Type": "AWS::CloudWatch::Alarm",
      "Properties": {
        "AlarmDescription": "Advertified data EC2 status check failed",
        "Namespace": "AWS/EC2",
        "MetricName": "StatusCheckFailed",
        "Dimensions": [
          {
            "Name": "InstanceId",
            "Value": {
              "Ref": "DatabaseHost"
            }
          }
        ],
        "Statistic": "Maximum",
        "Period": 60,
        "EvaluationPeriods": 2,
        "Threshold": 1,
        "ComparisonOperator": "GreaterThanOrEqualToThreshold",
        "TreatMissingData": "breaching",
        "AlarmActions": [
          {
            "Ref": "NotificationTopicArn"
          }
        ]
      }
    }
  },
  "Outputs": {
    "ApplicationHostId": {
      "Value": {
        "Ref": "ApplicationHost"
      }
    },
    "DatabaseHostId": {
      "Value": {
        "Ref": "DatabaseHost"
      }
    },
    "DatabaseVolumeId": {
      "Value": {
        "Ref": "DatabaseVolume"
      }
    },
    "ApplicationElasticIp": {
      "Value": {
        "Ref": "ApplicationElasticIp"
      }
    },
    "InventoryBucketName": {
      "Value": {
        "Ref": "InventoryBucket"
      }
    },
    "BackupBucketName": {
      "Value": {
        "Ref": "BackupBucket"
      }
    },
    "EventBusName": {
      "Value": {
        "Ref": "CommercialEventBus"
      }
    },
    "EventBusArn": {
      "Value": {
        "Fn::GetAtt": [
          "CommercialEventBus",
          "Arn"
        ]
      }
    },
    "ApiRepositoryUri": {
      "Value": {
        "Fn::GetAtt": [
          "ApiRepository",
          "RepositoryUri"
        ]
      }
    },
    "MigratorRepositoryUri": {
      "Value": {
        "Fn::GetAtt": [
          "MigratorRepository",
          "RepositoryUri"
        ]
      }
    },
    "AgentRuntimeRepositoryUri": {
      "Value": {
        "Fn::GetAtt": [
          "AgentRuntimeRepository",
          "RepositoryUri"
        ]
      }
    },
    "WebRepositoryUri": {
      "Value": {
        "Fn::GetAtt": [
          "WebRepository",
          "RepositoryUri"
        ]
      }
    },
    "DatabaseRepositoryUri": {
      "Value": {
        "Fn::GetAtt": [
          "DatabaseRepository",
          "RepositoryUri"
        ]
      }
    }
  },
  "Metadata": {
    "AdvertifiedBootstrap": {
      "CommonSha256": "a5f3f5e5ed77249b312651ea0b93ed15533d7296a2472e25b034179e65f4c883",
      "ApplicationSha256": "c0aa6625f82700832979fd41229c0edc16313cf995d43f396b3f9c3a8286a631",
      "DatabaseSha256": "31b21f30d495c7f04e79e649dfa8ee5c9a46e576dfd153d64624853eeda9c2f4",
      "DatabaseActivationSha256": "c026c188ab26bd350581656cde659a04b177a7731fed218b11385de9f7e2bff9",
      "DatabaseBackupSha256": "a8f2d9ad19484e5b10a8267b8cc0c3109cebb6c70c5b953b8782fe1c59e718dd",
      "DatabaseRestoreSha256": "3d97a87c27e599488efd0e4be330fc9041abfa2a6c9d4064acf64183212a07a2",
      "DatabaseLoginProvisionerSha256": "7059436ed25de2ef71ff824ca6d4e7b17ad5f81b3893a4fd3dc1ee7c15f51934",
      "DatabaseGroupRolesSqlSha256": "df7ac837f50b7113fa7ada829cb4a8332cd97b04567fd466d48dd95aa3e171fa"
    }
  }
}
