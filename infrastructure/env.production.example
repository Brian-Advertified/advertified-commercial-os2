# Advertified production configuration contract.
# Supply values through the deployment secret/configuration store. Do not commit a populated copy.
# Host-only Compose inputs must reference registry digests, never mutable tags.
ADVERTIFIED_API_IMAGE=REPLACE_WITH_REGISTRY_IMAGE@sha256:REPLACE_WITH_DIGEST
ADVERTIFIED_MIGRATOR_IMAGE=REPLACE_WITH_REGISTRY_IMAGE@sha256:REPLACE_WITH_DIGEST
ADVERTIFIED_AGENT_RUNTIME_IMAGE=REPLACE_WITH_REGISTRY_IMAGE@sha256:REPLACE_WITH_DIGEST
ADVERTIFIED_WEB_IMAGE=REPLACE_WITH_REGISTRY_IMAGE@sha256:REPLACE_WITH_DIGEST
ADVERTIFIED_API_ENV_FILE=/etc/advertified/api.env
ADVERTIFIED_WORKER_ENV_FILE=/etc/advertified/worker.env
ADVERTIFIED_MIGRATOR_ENV_FILE=/etc/advertified/migrator.env
# Non-secret model routing; operation keys contain literal double underscores and must stay in JSON.
ADVERTIFIED_API_CONFIG_FILE=/etc/advertified/appsettings.Production.json
ADVERTIFIED_AGENT_ENV_FILE=/etc/advertified/agent-runtime.env
ADVERTIFIED_DATA_PROTECTION_KEYS_DIR=/var/lib/advertified/data-protection-keys
ADVERTIFIED_DATA_PROTECTION_CERT_PATH=/etc/advertified/data-protection.pfx
ADVERTIFIED_WEB_PORT=8080

ASPNETCORE_ENVIRONMENT=Production
Process__Role=Api
ConnectionStrings__CommercialDatabase=REPLACE_WITH_APPLICATION_DATABASE_CONNECTION
AllowedHosts=advertified.com;www.advertified.com

# Reverse proxy / browser security
Authentication__Mode=Oidc
Authentication__Oidc__ProviderCode=cognito
Authentication__Oidc__Authority=https://REPLACE_WITH_COGNITO_AUTHORITY
Authentication__Oidc__ClientId=REPLACE_WITH_COGNITO_CLIENT_ID
Authentication__Oidc__ClientSecret=REPLACE_WITH_SECRET
Authentication__Oidc__LogoutEndpoint=https://REPLACE_WITH_COGNITO_LOGOUT_ENDPOINT
Authentication__Oidc__PostLogoutRedirectUri=https://advertified.com/sign-in
Authentication__BrowserSession__SecureCookie=true
Authentication__DataProtection__ApplicationName=Advertified.Commercial
Authentication__DataProtection__KeysDirectory=/var/lib/advertified/data-protection-keys
Authentication__DataProtection__CertificatePath=/run/secrets/data-protection.pfx
Authentication__DataProtection__CertificatePassword=REPLACE_WITH_SECRET
Authentication__BrowserSession__AllowedOrigins__0=https://advertified.com
Authentication__BrowserSession__AllowedOrigins__1=https://www.advertified.com
TrustedProxies__KnownNetworks__0__Prefix=REPLACE_WITH_PROXY_NETWORK
TrustedProxies__KnownNetworks__0__PrefixLength=REPLACE_WITH_PREFIX_LENGTH

# Protected source/object storage. AwsS3 uses the AWS default credential chain / EC2 IAM role.
# Production malware protection uses an external asynchronous verdict pipeline; deterministic scanning is forbidden.
InventoryProtection__ObjectStoreMode=AwsS3
InventoryProtection__Bucket=REPLACE_WITH_PRIVATE_S3_BUCKET
InventoryProtection__AwsRegion=af-south-1
InventoryProtection__ScannerMode=ExternalVerdict
InventoryProtection__MaximumSourceBytes=104857600

# Production source extraction uses deterministic native PDF/Office preprocessing,
# followed by the governed inventory-intelligence Bedrock route for source transcription
# and semantic enrichment. Startup fails closed if this worker is paused or semantic
# extraction is disabled.
InventoryExtraction__Mode=Native
InventoryProcessing__Paused=false
InventorySemantic__Enabled=true
InventorySemantic__ModelId=amazon.nova-lite-v1:0
InventorySemantic__InputPricePerMillionTokensUsdMicros=REPLACE_WITH_VERIFIED_INPUT_PRICE_USD_MICROS
InventorySemantic__OutputPricePerMillionTokensUsdMicros=REPLACE_WITH_VERIFIED_OUTPUT_PRICE_USD_MICROS
InventorySemantic__PerCallCostCapUsdMicros=REPLACE_WITH_APPROVED_PER_CALL_COST_CAP_USD_MICROS
InventorySemantic__CertificationBudgetUsdMicros=5000000
InventorySemantic__BudgetScope=inventory-production
InventorySemantic__PromptVersion=4.0.0

# C# -> Python AI boundary. Production uses the exact private Compose service endpoint;
# any other non-local runtime endpoint must use HTTPS. The service key remains mandatory.
AgentRuntime__Mode=Http
AgentRuntime__Provider=bedrock
AgentRuntime__BaseUrl=http://agent-runtime:8080
AgentRuntime__ServiceKey=REPLACE_WITH_SECRET
AgentRuntime__AllowLive=true
AgentRuntime__MaxAttempts=1
AgentRuntime__DefaultCostCapMinor=REPLACE_WITH_POSITIVE_GOVERNED_CAP
AgentRuntime__CostCapsMinor__business_interpretation=REPLACE_WITH_POSITIVE_GOVERNED_CAP
AgentRuntime__CostCapsMinor__opportunity_intelligence=REPLACE_WITH_POSITIVE_GOVERNED_CAP
AgentRuntime__CostCapsMinor__strategy=REPLACE_WITH_POSITIVE_GOVERNED_CAP
AgentRuntime__CostCapsMinor__critic_readiness=REPLACE_WITH_POSITIVE_GOVERNED_CAP
AgentRuntime__CostCapsMinor__brief_drafting=REPLACE_WITH_POSITIVE_GOVERNED_CAP
AgentRuntime__CostCapsMinor__market_intelligence=REPLACE_WITH_POSITIVE_GOVERNED_CAP
AgentRuntime__CostCapsMinor__audience_intelligence=REPLACE_WITH_POSITIVE_GOVERNED_CAP
AgentRuntime__CostCapsMinor__location_intelligence=REPLACE_WITH_POSITIVE_GOVERNED_CAP
AgentRuntime__CostCapsMinor__media_strategy=REPLACE_WITH_POSITIVE_GOVERNED_CAP
AgentRuntime__CostCapsMinor__inventory_intelligence=REPLACE_WITH_POSITIVE_GOVERNED_CAP
AgentRuntime__CostCapsMinor__proposal_narrative=REPLACE_WITH_POSITIVE_GOVERNED_CAP
AgentRuntime__CostCapsMinor__creative=REPLACE_WITH_POSITIVE_GOVERNED_CAP
AgentRuntime__CostCapsMinor__measurement=REPLACE_WITH_POSITIVE_GOVERNED_CAP
# Configure every model route in the mounted appsettings.Production.json using the production example.
# The Commercial API validates those routes; there is no default-model or provider fallback.

# Python agent-runtime environment
ADVERTIFIED_AGENT_RUNTIME_MODE=bedrock
ADVERTIFIED_INVENTORY_PROCESSING_PAUSED=false
ADVERTIFIED_AGENT_RUNTIME_SERVICE_KEY=REPLACE_WITH_SAME_SERVICE_SECRET
ADVERTIFIED_BEDROCK_REGION=us-east-1
ADVERTIFIED_BEDROCK_MODEL_ALLOWLIST=amazon.nova-lite-v1:0
ADVERTIFIED_BEDROCK_MULTIMODAL_MODEL_ALLOWLIST=amazon.nova-lite-v1:0
ADVERTIFIED_BEDROCK_PRICING_JSON=REPLACE_WITH_VERIFIED_MODEL_PRICING_JSON
ADVERTIFIED_BEDROCK_MAX_TOKENS=4096

# Inbound/outbound commercial email
EmailAutomation__Mode=Resend
EmailAutomation__ResendApiBaseUrl=https://api.resend.com/
EmailAutomation__ResendApiKey=REPLACE_WITH_SECRET
EmailAutomation__ResendWebhookSecret=REPLACE_WITH_SECRET
EmailAutomation__SenderAddress=noreply@advertified.com
EmailAutomation__ProcessInline=false

# Durable event dispatch / worker. Use the production stack EventBusName output.
OutboxDispatch__Mode=EventBridge
OutboxDispatch__AwsRegion=af-south-1
OutboxDispatch__EventBusName=REPLACE_WITH_EVENT_BUS
OutboxDispatch__EventSource=advertified.commercial
WorkerDispatch__InventoryExtractionMaxConcurrency=REPLACE_WITH_MEASURED_LIMIT

# Mapbox is public browser configuration; restrict the token to Advertified production origins in Mapbox.
VITE_MAPBOX_PUBLIC_TOKEN=REPLACE_WITH_ORIGIN_RESTRICTED_PUBLIC_TOKEN
