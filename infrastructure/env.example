# Advertified Unified - Environment Configuration Example
# Copy this file to .env and update values for your environment

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=advertified
POSTGRES_USER=advertified
POSTGRES_PASSWORD=dev_password_change_in_production
POSTGRES_SSL_MODE=disable

# =============================================================================
# STORAGE CONFIGURATION (S3-compatible)
# =============================================================================
STORAGE_ENDPOINT=http://minio:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin_change_in_production
STORAGE_BUCKET=advertified-dev
STORAGE_REGION=us-east-1
STORAGE_USE_SSL=false

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# =============================================================================
# COMMERCIAL API CONFIGURATION
# =============================================================================
API_PORT=5000
API_ENVIRONMENT=development
API_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
API_JWT_SECRET=dev_jwt_secret_change_in_production
API_JWT_EXPIRATION_HOURS=24

# =============================================================================
# AGENT RUNTIME CONFIGURATION
# =============================================================================
AGENT_RUNTIME_PORT=8000
AGENT_RUNTIME_ENVIRONMENT=development
AGENT_LOG_LEVEL=INFO

# =============================================================================
# AWS BEDROCK CONFIGURATION
# =============================================================================
AWS_REGION=us-east-1
AWS_BEDROCK_ENABLED=false
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key
# BEDROCK_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0

# =============================================================================
# EMAIL CONFIGURATION (Resend)
# =============================================================================
RESEND_API_KEY=dev_resend_key_change_in_production
RESEND_FROM_EMAIL=noreply@advertified.com

# =============================================================================
# MAPS CONFIGURATION
# =============================================================================
MAPS_PROVIDER=mapbox
# MAPBOX_API_KEY=your_mapbox_key

# =============================================================================
# PAYMENT CONFIGURATION
# =============================================================================
VODAPAY_API_KEY=dev_vodapay_key_change_in_production
VODAPAY_MERCHANT_ID=dev_merchant_id
VODAPAY_ENVIRONMENT=sandbox

# =============================================================================
# DOCUMENT EXTRACTION (Docling)
# =============================================================================
DOCLING_MODEL_PATH=/models/docling
DOCLING_ENABLED=true

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
CSRF_COOKIE_NAME=advertified_csrf
SESSION_COOKIE_NAME=advertified_session
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# =============================================================================
# FEATURE FLAGS
# =============================================================================
FEATURE_RAPID_OOH=true
FEATURE_SUPPLIER_MARKETPLACE=false
FEATURE_PREDICTIVE_ANALYTICS=false
FEATURE_IDENTITY_GRAPH=false

# =============================================================================
# MONITORING CONFIGURATION
# =============================================================================
LOG_LEVEL=info
METRICS_ENABLED=true
TRACING_ENABLED=false

# =============================================================================
# AI COST CONTROLS
# =============================================================================
AI_COST_CAP_MINOR=10000000  # $100.00 in minor units
AI_COST_TENANT_CAP_MINOR=50000000  # $500.00 per tenant
AI_COST_ALERT_THRESHOLD_MINOR=8000000  # Alert at $80.00