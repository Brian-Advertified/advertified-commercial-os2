# Copy to infrastructure/.env for local development only.
# Never reuse these local values in a shared, staging, or production environment.

POSTGRES_DB=advertified
POSTGRES_USER=advertified
POSTGRES_PASSWORD=replace-with-local-only-password
POSTGRES_PORT=55432

MINIO_ROOT_USER=advertified-local
MINIO_ROOT_PASSWORD=replace-with-local-only-password
MINIO_API_PORT=59000
MINIO_CONSOLE_PORT=59001
InventoryProtection__AccessKey=advertified-local
InventoryProtection__SecretKey=replace-with-local-only-password
# This is the one application upload-limit setting; the database and scanner enforce a 100 MiB ceiling.
InventoryProtection__MaximumSourceBytes=104857600

CLAMAV_PORT=53310

DOCLING_PORT=55001
DOCLING_API_KEY=replace-with-local-only-docling-key
InventoryExtraction__Mode=Docling
InventoryExtraction__BaseUrl=http://localhost:55001
InventoryExtraction__ApiKey=replace-with-local-only-docling-key
InventoryExtraction__TimeoutSeconds=180

REDIS_PORT=56379
MAIL_SMTP_PORT=51025
MAIL_UI_PORT=58025

API_PORT=5000
AGENT_RUNTIME_PORT=8000
WEB_PORT=5173
ALLOWED_ORIGINS=http://localhost:5173

# Live AI is closed by default. Local Compose overrides this to deterministic zero-cost mode.
ADVERTIFIED_AGENT_RUNTIME_MODE=disabled
ADVERTIFIED_BEDROCK_REGION=
ADVERTIFIED_BEDROCK_MODEL_ALLOWLIST=
ADVERTIFIED_BEDROCK_PRICING_JSON={}
ADVERTIFIED_BEDROCK_MAX_TOKENS=4096
AI_COST_CAP_MINOR=0
