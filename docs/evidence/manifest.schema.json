{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Advertified gate evidence manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "gate",
    "evidenceDate",
    "repository",
    "branch",
    "workingTreeState",
    "liveProviderUsed",
    "productionResourcesUsed",
    "incrementalAiCostMinor",
    "checks",
    "unresolvedBlockers",
    "ownerReview"
  ],
  "properties": {
    "$schema": {"type": "string", "minLength": 1},
    "schemaVersion": {"const": "1.0.0"},
    "gate": {"type": "integer", "minimum": 0, "maximum": 13},
    "evidenceDate": {"type": "string", "format": "date"},
    "repository": {"type": "string", "minLength": 1},
    "branch": {"type": "string", "minLength": 1},
    "baseCommit": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
    "workingTreeState": {
      "enum": ["CLEAN", "UNCOMMITTED_REVIEW", "STAGED_REVIEW"]
    },
    "liveProviderUsed": {"type": "boolean"},
    "productionResourcesUsed": {"type": "boolean"},
    "incrementalAiCostMinor": {"type": "integer", "minimum": 0},
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "command", "outcome"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "command": {"type": "string", "minLength": 1},
          "outcome": {"enum": ["PASS", "FAIL", "BLOCKED", "PENDING"]},
          "summary": {"type": "string"}
        }
      }
    },
    "unresolvedBlockers": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "ownerReview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "owner", "decisionDate"],
      "properties": {
        "status": {"enum": ["PENDING", "APPROVED", "REJECTED"]},
        "owner": {"type": ["string", "null"]},
        "decisionDate": {"type": ["string", "null"], "format": "date"}
      }
    }
  }
}
