{
  "name": "advertified-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "bootstrap": "npm install",
    "master-data:generate": "node ../tools/generate-master-data.mjs",
    "master-data:check": "node ../tools/generate-master-data.mjs --check",
    "inventory:extract-sources": "python ../tools/extract_inventory_sources.py",
    "inventory:reproject-corpus": "python ../tools/reproject_inventory_corpus.py",
    "inventory:inspect-storage": "powershell -ExecutionPolicy Bypass -File ../tools/inspect-os2-corpus-storage.ps1",
    "inventory:materialize-sources": "powershell -ExecutionPolicy Bypass -File ../tools/materialize-os2-corpus-sources.ps1",
    "inventory:update-os2-api": "powershell -ExecutionPolicy Bypass -File ../tools/update-os2-api-only.ps1",
    "openapi:generate": "node ../tools/generate-openapi.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint src e2e vite.config.ts playwright.config.ts playwright.connected.config.ts playwright.session-durability.config.ts",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "seed:local-proposals": "node ../tools/apply-local-development-seed.mjs",
    "type-check": "tsc --noEmit",
    "preview": "vite preview"
  },
  "dependencies": {
    "lucide-react": "0.468.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-router-dom": "7.18.3",
    "react-toastify": "11.1.0",
    "zod": "4.5.2"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.1.0",
    "oxlint": "1.79.0",
    "typescript": "6.0.2",
    "vite": "8.2.2"
  }
}
