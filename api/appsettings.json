{
  "Authentication": {
    "Mode": "Disabled"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    },
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": {
        "IncludeScopes": false,
        "UseUtcTimestamp": true,
        "TimestampFormat": "yyyy-MM-dd'T'HH:mm:ss.fff'Z'",
        "JsonWriterOptions": {
          "Indented": false
        }
      }
    }
  },
  "AgentRuntime": {
    "RecoverySweepSeconds": 300,
    "ReconnectMinSeconds": 5,
    "ReconnectMaxSeconds": 60
  },
  "AllowedHosts": "*"
}
