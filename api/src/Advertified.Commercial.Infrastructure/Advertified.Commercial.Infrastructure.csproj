<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Advertified.Commercial.Application/Advertified.Commercial.Application.csproj" />
    <ProjectReference Include="../Advertified.Commercial.Domain/Advertified.Commercial.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AWSSDK.EventBridge" Version="4.0.100.4" />
    <PackageReference Include="AWSSDK.S3" Version="4.0.102.5" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.11" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="Minio" Version="7.0.0" />
    <PackageReference Include="PDFsharp-MigraDoc" Version="6.2.4" />
    <PackageReference Include="PdfPig" Version="0.1.16" />
    <PackageReference Include="Uno.Fonts.OpenSans" Version="2.9.4" GeneratePathProperty="true" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(PkgUno_Fonts_OpenSans)/lib/net7.0/Uno.Fonts.OpenSans/Fonts/OpenSans-Regular.ttf"
      Link="ProposalFonts/OpenSans-Regular.ttf"
      CopyToOutputDirectory="PreserveNewest"
      CopyToPublishDirectory="PreserveNewest" />
    <None Include="$(PkgUno_Fonts_OpenSans)/lib/net7.0/Uno.Fonts.OpenSans/Fonts/OpenSans-Bold.ttf"
      Link="ProposalFonts/OpenSans-Bold.ttf"
      CopyToOutputDirectory="PreserveNewest"
      CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Migrations/InitialBaseline.g.sql"
      LogicalName="Advertified.Database.InitialBaseline.sql" />
    <EmbeddedResource
      Include="../../../shared/contracts/master-data.json"
      LogicalName="Advertified.MasterData.Registry.json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Advertified.Commercial.Api.Tests" />
  </ItemGroup>
</Project>
