{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Advertified Master Data Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["registryVersion", "effectiveFrom", "collections"],
  "properties": {
    "$schema": {"type": "string"},
    "registryVersion": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "effectiveFrom": {"type": "string", "format": "date"},
    "description": {"type": "string"},
    "collections": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "array",
        "items": {"$ref": "#/definitions/record"}
      }
    }
  },
  "definitions": {
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "displayLabel", "isActive", "sortOrder"],
      "properties": {
        "code": {"type": "string", "pattern": "^[A-Za-z0-9_]+$"},
        "displayLabel": {"type": "string", "minLength": 1},
        "isActive": {"type": "boolean"},
        "sortOrder": {"type": "integer", "minimum": 0},
        "metadata": {"type": "object"}
      }
    }
  }
}
